ation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MULTIGUILD_PLAN.md", "source_location": null, "weight": 1.0}, {"source": "multiguild_plan_phase4_scalability", "target": "multiguild_plan_settings_db", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "MULTIGUILD_PLAN.md", "source_location": null, "weight": 1.0}, {"source": "multiguild_plan_manage_server_access_model", "target": "multiguild_plan_superadmin_main_check", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "MULTIGUILD_PLAN.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "multiguild_plan_phase2_multiguild_core", "label": "Phase 2 Multi-Guild Core", "nodes": ["multiguild_plan_settings_db", "multiguild_plan_guild_dimension_migration", "multiguild_plan_oauth_guilds_flow", "multiguild_plan_bot_global_sync"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MULTIGUILD_PLAN.md"}, {"id": "multiguild_plan_main_guild_privileges", "label": "Main Guild Privileged Features", "nodes": ["multiguild_plan_main_guild_id", "multiguild_plan_ctd_main_guild_gate", "multiguild_plan_news_relay_superadmin", "multiguild_plan_superadmin_main_check"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MULTIGUILD_PLAN.md"}, {"id": "multiguild_plan_ru_en_localization_program", "label": "RU/EN Localization Program", "nodes": ["multiguild_plan_i18n_infrastructure", "multiguild_plan_two_level_language_model", "multiguild_plan_slash_command_localization", "multiguild_plan_bunker_cards_bilingual"], "relation": "implement", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "MULTIGUILD_PLAN.md"}]}