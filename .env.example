# ==========================================
# CHETERIN BOT — copy to .env and fill in
# Never commit real tokens/secrets. Values below are placeholders only.
# ==========================================
# Discord bot token (never commit real values)
BOT_TOKEN=

# Optional webhook for button collector / system logs
BUTTON_WEBHOOK_URL=
BUTTON_WEBHOOK_USERNAME=
BUTTON_WEBHOOK_AVATAR_URL=

# Primary / main guild (CTD, news-relay, super-admin defaults)
GUILD_ID=
# MAIN_GUILD_ID=

# Invite link shown to users
SERVER_INVITE_LINK=


# ==========================================
# CHANNELS (optional defaults; prefer dashboard)
# ==========================================
LOG_CHANNEL_ID=
INVITE_LOG_CHANNEL_ID=
WELCOME_CHANNEL_ID=
ANNOUNCEMENTS_CHANNEL_ID=
ROLES_CHANNEL_ID=
RULES_CHANNEL_ID=
SEARCH_PLAYERS_CHANNEL_ID=


# ==========================================
# FEEDBACK / MODERATION (optional)
# ==========================================
CHANNEL_COMPLAINT_PLAY=
CHANNEL_COMPLAINT_CHAT=
CHANNEL_APPEAL=
CHANNEL_REPORT=
CHANNEL_IDEA=
MOD_ROLE_ID=
MUTE_ROLE_ID=


# ==========================================
# ROLES / PERMISSIONS (optional)
# ==========================================
BUTTON_CREATE_ALLOWED_ROLES=


# ==========================================
# DASHBOARD
# ==========================================
DASHBOARD_PORT=8080
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=https://cheterin.online/api/auth/discord/callback
SESSION_SECRET=

# Optional transitional extra role grant on the active guild (usually leave empty).
# DASHBOARD_ACCESS_ROLE_IDS=

# Slash sync strategy: per_guild (default) | global
# COMMAND_SYNC_MODE=per_guild
# COMMAND_SYNC_HIDE_DISABLED=0
# COMMAND_SYNC_CLEAR_GLOBAL=0

# Public frontend URL (embeds / guild-join greeting)
# DASHBOARD_FRONTEND_URL=https://cheterin.online


# ==========================================
# VALORANT / ValChecker (optional)
# ==========================================
# HenrikDev API key (Authorization header, raw — no "Bearer " prefix)
HENRIK_API_KEY=


# ==========================================
# STREAMS / TWITCH (optional)
# ==========================================
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=


# ==========================================
# LOOKUP (separate process — use lookup-api/.env, not this file)
# ==========================================
# Do not put Lookup Discord tokens here and never reuse BOT_TOKEN.
# See lookup-api/.env.example:
#   LOOKUP_DISCORD_TOKENS=...   (comma-list, round-robin + 429 rotate)
#   LOOKUP_DISCORD_TOKEN=       (single-token fallback)
#   LOOKUP_CAPTCHA_*            (optional; widget off until keys are set)
