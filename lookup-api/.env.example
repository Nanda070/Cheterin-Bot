# Cheterin Lookup API - environment template (no secrets)
# Copy to lookup-api/.env or set in the process environment.

# ---------------------------------------------------------------------------
# Discord token(s) for Lookup ONLY (never use BOT_TOKEN / Cheterin bot token)
# ---------------------------------------------------------------------------

# Option A - multi-token round-robin (recommended for production):
#   Comma-separated list of bot tokens.  Requests are distributed round-robin;
#   on HTTP 429 the pool immediately rotates to the next token.
# LOOKUP_DISCORD_TOKENS=Token1,Token2,Token3

# Option B - single token fallback (used when LOOKUP_DISCORD_TOKENS is absent):
LOOKUP_DISCORD_TOKEN=

# ---------------------------------------------------------------------------
# Bind address
LOOKUP_API_HOST=127.0.0.1
LOOKUP_API_PORT=8090

# Public application IDs for permissions calculator presets (not secrets)
LOOKUP_CLIENT_ID=
CHETERIN_CLIENT_ID=

# CAPTCHA provider wiring. Keep false until configured.
LOOKUP_CAPTCHA_ENABLED=false
# LOOKUP_CAPTCHA_SITE_KEY=
# LOOKUP_CAPTCHA_SECRET=